{
  "name": "@catmaitachi/kittens",
  "version": "0.1.0",
  "description": "Pixel-art kittens that live inside any element of your page: they walk, run, jump onto elements, climb walls, play, groom and sleep.",
  "keywords": [
    "pet",
    "pixel-art",
    "cat",
    "kitten",
    "web-component",
    "typescript",
    "vscode-pets"
  ],
  "license": "MIT",
  "author": "Lucas Spiazzi",
  "homepage": "https://github.com/catmaitachi/kittens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catmaitachi/kittens.git"
  },
  "bugs": {
    "url": "https://github.com/catmaitachi/kittens/issues"
  },
  "type": "module",
  "main": "./dist/kittens.umd.cjs",
  "module": "./dist/kittens.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/kittens.js",
      "require": "./dist/kittens.umd.cjs"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": [
    "./dist/kittens.js",
    "./dist/kittens.umd.cjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "build:site": "vite build --mode site",
    "preview:site": "vite preview --mode site",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "sprites": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/export-sprites.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
